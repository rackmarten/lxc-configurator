LOCALE=en_US.UTF-8
TIMEZONE=UTC

# LXC user
USER_NAME=marek
USER_PASSWORD=
USER_SHELL=/bin/zsh
USER_GROUPS=sudo,docker

# Git
GIT_USER_NAME=
GIT_USER_EMAIL=
GIT_DEFAULT_BRANCH=main

# SSH public key(s) to authorize - written verbatim to the new user's
# authorized_keys, so more than one key can go here (one per line, e.g. the
# desktop's key plus foreman's - see foreman's own AGENTS.md, "Every LXC
# trusts foreman's key" for why a second machine needs to be in here from
# day one, not appended by hand after the fact). Re-running the `user`
# module against an already-provisioned LXC overwrites authorized_keys
# with whatever is in this var, so keep it in sync with whichever keys
# should actually have standing access before doing that.
SSH_PUBLIC_KEY=

TAILSCALE_LOGIN_SERVER=
TAILSCALE_AUTH_KEY=
# Optional: LAN IP of the reverse proxy fronting the login server. When set,
# the login server's hostname is pinned to it in the LXC's /etc/hosts, so
# Tailscale reaches headscale over the LAN instead of via the public IP
# (the ISP router's hairpin NAT drops idle connections after ~30-60s).
TAILSCALE_LOGIN_SERVER_LAN_IP=

# Grafana Alloy
LOKI_URL=

# Kopia backup client. Enroll clients with scripts/kopia-enroll.sh, which
# generates a password per client, so there is deliberately no shared
# KOPIA_CLIENT_PASSWORD here. What each client backs up is read from
# $KOPIA_CLIENTS_FILE (default ./kopia-clients.tsv; see
# kopia-clients.tsv.example). KOPIA_SERVER_CERT_FINGERPRINT is printed by the
# Kopia server on first start.
KOPIA_SERVER_URL=
KOPIA_SERVER_CERT_FINGERPRINT=

# Create LXC
LXC_TEMPLATE=local:vztmpl/debian-13-standard_13.1-2_amd64.tar.zst
LXC_STORAGE=lxc-storage
LXC_BRIDGE=vmbr0
# auto derives the address from the CTID: CTID 117 becomes 192.168.0.117. The
# homelab's router hands out DHCP only from .150 up, so the 100-149 range is
# reserved for guests addressed this way and a container's IP is never
# something to look up. Use dhcp or an explicit address/cidr to opt out.
LXC_IP=auto
LXC_LAN_PREFIX=192.168.0
LXC_LAN_CIDR=24
# Bounds enforced for LXC_IP=auto. The floor is Proxmox's own minimum VMID; the
# ceiling must stay below the router's DHCP pool, or auto would hand out an
# address the router can also lease to something else. Raising the ceiling means
# shrinking that pool on the router first.
LXC_CTID_MIN=100
LXC_CTID_MAX=149
LXC_GATEWAY=192.168.0.1
LXC_CORES=2
LXC_MEMORY=2048
LXC_SWAP=512
LXC_DISK=8
LXC_START=1
LXC_UNPRIVILEGED=1
LXC_NESTING=1
CREATE_PROFILE=default

# Working directory
WORK_DIR=/app

# Working directory scaffold
# By default every file under templates/work-dir is scaffolded; use
# `--component <path>` on the CLI to scaffold a subset instead.
WORK_DIR_SCAFFOLD_INIT_GIT=true
WORK_DIR_PROJECT_NAME=
